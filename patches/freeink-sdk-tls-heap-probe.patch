   const int err = wolfSSL_get_error(ssl, n);
   if (isWantIo(err)) return 0;
@@ -190,6 +299,16 @@ int SecureClient::read(uint8_t* buf, size_t size) {
   // A mid-stream failure is invisible to callers (they just see the connection
   // die); the error code distinguishes an OOM (MEMORY_E -125) from a peer
   // drop or MAC failure.
+  //
+  // It goes through the heap probe as well as Serial, because on the device
+  // this matters to there is no serial port: burn 17 reported a short body and
+  // left no record of whether the stream was lost to an allocation failure or
+  // to the peer. err=-125 is MEMORY_E.
+  if (g_heapProbe) {
