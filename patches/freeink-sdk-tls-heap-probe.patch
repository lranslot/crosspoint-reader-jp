@@ -51,6 +51,25 @@ class SecureClient : public Client {
   // True if the library was built with wolfSSL TLS 1.3 support enabled.
   static bool tls13Available();
 
+  // Optional heap probe, fired at the four points where a TLS session's memory
+  // cost is decided. A plain function pointer rather than std::function: the
+  // latter heap-allocates its closure and costs 2-4KB of binary per signature,
+  // which is the wrong trade in the one place we are measuring heap.
+  //
+  // It exists because the cost cannot be measured from outside: wolfSSL's
+  // receive buffer is sized to each incoming record inside wolfSSL_read, so the
+  // peak is reached and released between two calls the application makes. The
+  // SDK stays free of the application's diagnostics -- the application installs
+  // the probe and decides what to do with the tags.
+  //
+  // Tags, in the order they fire:
+  //   tls-before     after the TCP connect, before wolfSSL_connect
+  //   tls-handshake  handshake complete (the peak, if there is one)
+  //   tls-record     first record decrypted (first wolfSSL_read that returns data)
+  //   tls-after      session freed
+  using HeapProbe = void (*)(const char* tag, const char* detail);
+  static void setHeapProbe(HeapProbe probe);
