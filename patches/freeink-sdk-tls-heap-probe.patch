 void SecureClient::stop() {
+  const bool hadSession = _ssl != nullptr;
   if (_ssl) { wolfSSL_free(static_cast<WOLFSSL*>(_ssl)); _ssl = nullptr; }
   if (_ctx) { wolfSSL_CTX_free(static_cast<WOLFSSL_CTX*>(_ctx)); _ctx = nullptr; }
   _transport.stop();
   _connected = false;
+  _firstRecordSeen = false;
+  // Only when there was something to free: stop() is also called at the top of
+  // every connect attempt, and a sample for a session that never existed would
+  // be a line that looks like a release and is not one.
+  // After the frees, so it reports what came back rather than what was still
+  // standing (spec 8.8-33/35). The session is gone by now, so the buffer sizes
+  // cannot be read here -- the deltas are the point.
+  if (hadSession) probeClose("tls-after", ESP.getFreeHeap(), ESP.getMaxAllocHeap());
 }
 
