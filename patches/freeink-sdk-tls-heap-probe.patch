index 26d3abc..246ec70 100644
--- a/libs/network/SecureNet/src/SecureClient.cpp
+++ b/libs/network/SecureNet/src/SecureClient.cpp
@@ -53,8 +53,42 @@ bool isWantIo(const int err) {
   // an out-of-memory handshake spin until the deadline instead of failing fast.
   return err == WOLFSSL_ERROR_WANT_READ || err == WOLFSSL_ERROR_WANT_WRITE;
 }
+
+// What the max_fragment_length extension asked the peer for, in bytes, or 0
+// when the extension is not compiled in. Printed with every sample so the
+// before/after comparison is readable from the log alone rather than from
+// knowing which firmware wrote it.
+int maxFragmentBytes() {
+#ifdef HAVE_MAX_FRAGMENT
+  return 2048;  // WOLFSSL_MFL_2_11
+#else
+  return 0;
+#endif
+}
+
+// Installed by the application; null unless it asked to measure.
+SecureClient::HeapProbe g_heapProbe = nullptr;
+
+// Reports free heap and, separately, the largest single block. Both are needed:
+// the TLS receive buffer is ONE allocation sized to the incoming record, so the
+// largest block is what decides whether it can be made, while the total is what
+// decides whether everything else survives. A measured run showed both failing
+// independently -- one pass entered with max=61,428 and still ended at
+// free=2,048.
+void probe(const char* tag, const int extra = -1) {
+  if (!g_heapProbe) return;
+  char detail[64];
+  if (extra >= 0) {
+    snprintf(detail, sizeof(detail), "maxfrag=%d bytes=%d", maxFragmentBytes(), extra);
+  } else {
+    snprintf(detail, sizeof(detail), "maxfrag=%d", maxFragmentBytes());
+  }
+  g_heapProbe(tag, detail);
+}
 }  // namespace
 
+void SecureClient::setHeapProbe(const HeapProbe probe) { g_heapProbe = probe; }
