 // integration point for the TLS 1.3 transport.
 #if defined(FREEINK_NET_WOLFSSL)
 #include <wolfssl/ssl.h>
+// For ssl->buffers.inputBuffer.bufferSize: the size wolfSSL has grown its
+// receive buffer to, which is the figure the max_fragment_length extension is
+// supposed to hold down. There is no public accessor for it.
+#include <wolfssl/internal.h>
 #endif
 
 namespace freeink {
@@ -53,8 +57,90 @@ bool isWantIo(const int err) {
   // an out-of-memory handshake spin until the deadline instead of failing fast.
   return err == WOLFSSL_ERROR_WANT_READ || err == WOLFSSL_ERROR_WANT_WRITE;
 }
+
+// What the max_fragment_length extension asked the peer for, in bytes, or 0
+// when the extension is not compiled in. Printed with every sample so the
+// before/after comparison is readable from the log alone rather than from
+// knowing which firmware wrote it.
+int maxFragmentBytes() {
+#ifdef HAVE_MAX_FRAGMENT
+  return 2048;  // WOLFSSL_MFL_2_11
+#else
+  return 0;
+#endif
+}
+
+// Installed by the application; null unless it asked to measure.
+SecureClient::HeapProbe g_heapProbe = nullptr;
+
+// Reports free heap and, separately, the largest single block. Both are needed:
+// the TLS receive buffer is ONE allocation sized to the incoming record, so the
+// largest block is what decides whether it can be made, while the total is what
+// decides whether everything else survives. A measured run showed both failing
+// independently -- one pass entered with max=61,428 and still ended at
+// free=2,048.
+// Counts TLS sessions since boot, so the three downloads of one font family can
+// be told apart in the log. The question being measured is no longer "can a
+// handshake happen" but "what does the Nth one cost", and without this the
+// lines are indistinguishable.
+uint16_t g_session = 0;
+
+// Readings at the previous tls-before, so tls-after can state the round trip in
+// one line instead of making the reader subtract two lines that are 30 lines
+// apart in the file.
+uint32_t g_freeAtStart = 0;
+uint32_t g_maxAtStart = 0;
+
+void probe(const char* tag, WOLFSSL* ssl, const int lastRead = -1) {
+  if (!g_heapProbe) return;
+
+  // The two record buffers, read straight out of the session. inbuf is the
+  // one that matters: GrowInputBuffer() sizes it to the largest record the peer
+  // has sent, so it IS the answer to "did the server honour the 2KB request" --
+  // 2KB-ish means yes, ~16.4KB means no.
+  //
+  // Not available through the public API, hence the internal.h include. If a
+  // wolfSSL update moves these fields this stops compiling, which is the right
+  // failure: a diagnostic that silently reads the wrong offset is worse than
+  // none (spec 8.8-30).
+  unsigned inbuf = 0;
+  unsigned outbuf = 0;
+  if (ssl) {
+    inbuf = static_cast<unsigned>(ssl->buffers.inputBuffer.bufferSize);
+    outbuf = static_cast<unsigned>(ssl->buffers.outputBuffer.bufferSize);
+  }
+
+  char detail[128];
+  if (lastRead >= 0) {
+    // read= is the return of wolfSSL_read, NOT a record size. It is reported
+    // because it was previously labelled "bytes=" and read as one: the first
+    // read of a response is a one-byte read from the header line parser, so it
+    // said bytes=1 on every session and answered nothing. Kept, honestly named.
+    snprintf(detail, sizeof(detail), "s=%u maxfrag=%d inbuf=%u outbuf=%u read=%d", (unsigned)g_session,
+             maxFragmentBytes(), inbuf, outbuf, lastRead);
+  } else {
+    snprintf(detail, sizeof(detail), "s=%u maxfrag=%d inbuf=%u outbuf=%u", (unsigned)g_session, maxFragmentBytes(),
+             inbuf, outbuf);
+  }
+  g_heapProbe(tag, detail);
+}
+
+// tls-after also states what came back, because the fault now under
+// investigation is not a failed handshake but a heap that degrades across
+// repeated sessions: free returned to within 24 bytes while the largest block
+// fell 42,996 -> 18,420 and never recovered. A line that says "free +24
+// max -24,576" is the whole finding; two lines to subtract is not.
+void probeClose(const char* tag, const uint32_t freeNow, const uint32_t maxNow) {
+  if (!g_heapProbe) return;
+  char detail[128];
+  snprintf(detail, sizeof(detail), "s=%u maxfrag=%d dfree=%+d dmax=%+d", (unsigned)g_session, maxFragmentBytes(),
+           (int)((int32_t)freeNow - (int32_t)g_freeAtStart), (int)((int32_t)maxNow - (int32_t)g_maxAtStart));
+  g_heapProbe(tag, detail);
+}
 }  // namespace
 
+void SecureClient::setHeapProbe(const HeapProbe probe) { g_heapProbe = probe; }
